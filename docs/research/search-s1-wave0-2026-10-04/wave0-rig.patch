diff --git a/iosApp/NuvioTV/Screens/SearchFieldSpike.swift b/iosApp/NuvioTV/Screens/SearchFieldSpike.swift
new file mode 100644
index 00000000..8de55bf8
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/SearchFieldSpike.swift
@@ -0,0 +1,587 @@
+import SwiftUI
+import UIKit
+import Combine
+
+/// THROWAWAY SPIKE (2026-10-04). Never merge; build it in a throwaway clone.
+///
+/// Question: can tvOS 26/27's system search field (`.searchable`) replace Search's plain
+/// `TextField` without the keyboard-bleed bug that got it banned (SearchView's header comment,
+/// `docs/design/hig-hybrid-contract.md`)? If it can, Search gets live results under the keyboard,
+/// Siri dictation, iPhone typing and the viewer's Linear/Grid keyboard choice (FEAT-37).
+///
+/// Launch with `-debug.searchFieldSpike A|B|C`. Unset (or anything else) = today's TextField,
+/// which is the control, and every spike code path below is inert.
+///
+/// - A "plain": `.searchable` on Search's existing results ScrollView, inside the tab's existing
+///   NavigationStack; titles push Detail as today. This is VortX's structure and exactly what
+///   the ban describes, so A answers "does the original bug still reproduce on tvOS 26/27?".
+/// - B "host": `.searchable` in its own clipped NavigationStack that holds only `Color.clear`
+///   (bobsupra NuvioTVOS's `NativeSearchKeyboardHost`); results are siblings below it (Linear
+///   keyboard) or to its right (Grid keyboard), and Detail is pushed by the OUTER stack, so
+///   nothing pushed can ever sit under the keyboard.
+/// - C "search tab": `Tab(role: .search)` with `.searchable` on the TabView (Apple's WWDC25
+///   pattern). The typed text lives in `TabQuery.shared`, which only SearchView observes, so
+///   typing never re-evaluates `MainTabView`'s body (the T3/BUG-66 rule in ContentView).
+///
+/// Every observation is logged as `[SearchSpike] t=<s> …` (NSLog), so a `devicectl … --console`
+/// stream or Console.app captures the whole walk. See
+/// `docs/research/search-field-spike-2026-10-04.md` in the outer repo for the legs.
+enum SearchFieldSpike {
+    enum Variant: String { case a = "A", a0 = "A0", a2 = "A2", b = "B", c = "C" }
+
+    /// Launch-latched: the variant can't change mid-session.
+    static let variant: Variant? = UserDefaults.standard
+        .string(forKey: "debug.searchFieldSpike")
+        .flatMap { Variant(rawValue: $0.uppercased()) }
+
+    /// What the walk is looking at, stamped into every keyboard-scan line: "search", "detail",
+    /// "grid" (See All) or "person". Main-actor state (project default isolation).
+    /// Pushed screens from Search, innermost last (a stack since the Mac run, 2026-10-04: with
+    /// Detail → person stacked, Detail's `onDisappear` used to reset the tag to "search" while the
+    /// person page was still on top).
+    static var screens: [String] = []
+    static var screen: String { screens.last ?? "search" }
+    static var tab = 0
+
+    /// Probe on: any variant, or the control with `-debug.searchFieldSpikeProbe YES` (added on the
+    /// Mac run, 2026-10-04: a control baseline for the keyboard detector and the latency lines;
+    /// the control's UI is unchanged either way).
+    static let probeEnabled: Bool = variant != nil
+        || UserDefaults.standard.bool(forKey: "debug.searchFieldSpikeProbe")
+
+    private static let t0 = Date()
+
+    // MARK: Wave 0 flags (S1 plan, 2026-10-04). All launch-latched, all off by default.
+
+    /// U6: hold the previous query's rows while the next query loads. 0 = off (today), 1 = swap on
+    /// the first new row, 2 = swap when the new fan-out finishes or 1 s after its first row.
+    static let rowsHoldMode: Int = UserDefaults.standard.integer(forKey: "debug.searchRowsHold")
+    /// U3: Menu pressed while focus is in the system keyboard opens the sidebar (Sidebar mode only).
+    static let menuRouter: Bool = UserDefaults.standard.bool(forKey: "debug.searchMenuRouter")
+    /// U4: link the tab bar to Search's results scroll view (`TabBarContentScrollLinkAttacher`).
+    static let tabBarLink: Bool = UserDefaults.standard.bool(forKey: "debug.searchTabBarLink")
+    /// U4 mode 2: link from the TOP (window root → tab controller → selected tab), because the
+    /// attacher's parent walk from inside `.searchable` stops at TVSearchController (sim 26.5).
+    static let tabBarLinkMode: Int = UserDefaults.standard.integer(forKey: "debug.searchTabBarLinkMode")
+
+    /// U2: body evaluations per view ("view", "layer", "content"), stamped on every `query` line.
+    private static var renders: [String: Int] = [:]
+    static func noteRender(_ name: String) {
+        guard probeEnabled else { return }
+        renders[name, default: 0] += 1
+    }
+    static func renderSummary() -> String {
+        "renders view=\(renders["view", default: 0]) layer=\(renders["layer", default: 0]) content=\(renders["content", default: 0])"
+    }
+
+    /// Every line also lands in `Library/Caches/search-spike.log` (appended, one header per
+    /// launch), because the `devicectl --console` stream to the Apple TV drops on its own
+    /// (Mercury error 1001). Pull it with `devicectl device copy from --domain-type
+    /// appDataContainer --domain-identifier com.youngchris29.NuvioTV --source
+    /// Library/Caches/search-spike.log --destination …`.
+    private static let fileHandle: FileHandle? = {
+        guard let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first
+        else { return nil }
+        let url = caches.appendingPathComponent("search-spike.log")
+        if !FileManager.default.fileExists(atPath: url.path) {
+            FileManager.default.createFile(atPath: url.path, contents: nil)
+        }
+        guard let handle = try? FileHandle(forWritingTo: url) else { return nil }
+        _ = try? handle.seekToEnd()
+        let header = "=== launch \(Date()) variant=\(variant?.rawValue ?? "control")\n"
+        try? handle.write(contentsOf: Data(header.utf8))
+        return handle
+    }()
+
+    static func log(_ message: @autoclosure () -> String) {
+        guard probeEnabled else { return }
+        let t = String(format: "%.3f", Date().timeIntervalSince(t0))
+        let line = "[SearchSpike] t=\(t) \(message())"
+        NSLog("%@", line)
+        try? fileHandle?.write(contentsOf: Data((line + "\n").utf8))
+    }
+
+    /// Variant C's query box. A reference type that `MainTabView` never observes; SearchView
+    /// subscribes to `$text`.
+    final class TabQuery: ObservableObject {
+        static let shared = TabQuery()
+        @Published var text = ""
+    }
+
+    /// The keyboard layout the scan last saw ("linear"/"grid"). Variant B lays out around it.
+    /// Never set back to "none", so a host rebuild can't flip the layout back and forth.
+    final class KeyboardState: ObservableObject {
+        static let shared = KeyboardState()
+        @Published var layout = "linear"
+    }
+}
+
+// MARK: - Variant A: .searchable on the results ScrollView
+
+struct SpikeSearchableA: ViewModifier {
+    @Binding var query: String
+    let onSubmit: () -> Void
+
+    func body(content: Content) -> some View {
+        if SearchFieldSpike.variant == .a {
+            content
+                .searchable(text: $query, prompt: "Search movies & shows")
+                .onSubmit(of: .search, onSubmit)
+        } else {
+            content
+        }
+    }
+}
+
+// MARK: - Variant A2: .searchable in the layer that observes only the query (Wave 0, U2)
+
+struct SpikeSearchableA2: ViewModifier {
+    @Binding var query: String
+    let onSubmit: () -> Void
+
+    func body(content: Content) -> some View {
+        if SearchFieldSpike.variant == .a2 {
+            content
+                .searchable(text: $query, prompt: "Search movies & shows")
+                .onSubmit(of: .search, onSubmit)
+        } else {
+            content
+        }
+    }
+}
+
+// MARK: - Variant B: the clipped keyboard host
+
+/// bobsupra's host: a NavigationStack with nothing in it but the search field. It is clipped to
+/// a fixed frame by the caller, and it never pushes anything.
+struct SpikeSearchFieldHost: View {
+    @Binding var text: String
+    let onSubmit: () -> Void
+
+    var body: some View {
+        NavigationStack {
+            Color.clear
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                .searchable(text: $text, prompt: "Search movies & shows")
+                .onSubmit(of: .search, onSubmit)
+                .toolbar(.hidden, for: .navigationBar)
+        }
+    }
+}
+
+/// Lays Search's results out around variant B's host; a pass-through for every other variant.
+struct SpikeSearchLayout<Results: View>: View {
+    @Binding var query: String
+    let onSubmit: () -> Void
+    let results: () -> Results
+    @ObservedObject private var keyboard = SearchFieldSpike.KeyboardState.shared
+
+    /// Explicit, because the private `keyboard` would make the synthesized init private.
+    init(
+        query: Binding<String>,
+        onSubmit: @escaping () -> Void,
+        @ViewBuilder results: @escaping () -> Results
+    ) {
+        _query = query
+        self.onSubmit = onSubmit
+        self.results = results
+    }
+
+    /// bobsupra's measured frames: Linear = 220 pt keyboard band under a 56 pt top inset;
+    /// Grid = a 780 × 780 column on the left.
+    private static var linearHeight: CGFloat { 220 + 56 }
+    private static var gridSide: CGFloat { 780 }
+
+    var body: some View {
+        if SearchFieldSpike.variant == .b {
+            if keyboard.layout == "grid" {
+                HStack(alignment: .top, spacing: Theme.Spacing.lg) {
+                    SpikeSearchFieldHost(text: $query, onSubmit: onSubmit)
+                        .frame(width: Self.gridSide, height: Self.gridSide, alignment: .topLeading)
+                        .clipped()
+                    results()
+                }
+            } else {
+                VStack(alignment: .leading, spacing: 0) {
+                    SpikeSearchFieldHost(text: $query, onSubmit: onSubmit)
+                        .padding(.top, 56)
+                        .frame(maxWidth: .infinity)
+                        .frame(height: Self.linearHeight, alignment: .top)
+                        .clipped()
+                    results()
+                }
+            }
+        } else {
+            results()
+        }
+    }
+}
+
+// MARK: - Variant C: .searchable on the TabView
+
+struct SpikeTabSearchable: ViewModifier {
+    func body(content: Content) -> some View {
+        if SearchFieldSpike.variant == .c {
+            content.searchable(
+                text: Binding(
+                    get: { SearchFieldSpike.TabQuery.shared.text },
+                    set: { SearchFieldSpike.TabQuery.shared.text = $0 }
+                ),
+                prompt: "Search movies & shows"
+            )
+        } else {
+            content
+        }
+    }
+}
+
+// MARK: - Probes
+
+/// Stamps `SearchFieldSpike.screen` while a pushed screen is on top, so a keyboard seen during
+/// "detail" is the original bleed bug.
+struct SpikeScreenTag: ViewModifier {
+    let name: String
+
+    func body(content: Content) -> some View {
+        content
+            .onAppear {
+                SearchFieldSpike.screens.append(name)
+                SearchFieldSpike.log("screen \(name) appear")
+            }
+            .onDisappear {
+                if let i = SearchFieldSpike.screens.lastIndex(of: name) {
+                    SearchFieldSpike.screens.remove(at: i)
+                }
+                SearchFieldSpike.log("screen \(name) disappear")
+            }
+    }
+}
+
+/// Zero-size probe. Every 250 ms while the spike is on, it walks every window of the scene for
+/// visible views whose class name contains "Keyboard" (bobsupra's detector heuristic) and logs
+/// the summary when it changes, together with the focused item's type and the tab bar's frame.
+/// Bleed = a keyboard line while `screen=detail`, or while `tab` isn't 1.
+struct SpikeKeyboardScanner: UIViewRepresentable {
+    func makeUIView(context: Context) -> SpikeKeyboardScanView { SpikeKeyboardScanView() }
+    func updateUIView(_ uiView: SpikeKeyboardScanView, context: Context) {}
+}
+
+final class SpikeKeyboardScanView: UIView {
+    private var loop: Task<Void, Never>?
+    private var lastKeyboard = ""
+    private var lastFocus = ""
+    private var lastTabBar = ""
+
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        loop?.cancel()
+        loop = nil
+        guard window != nil, SearchFieldSpike.probeEnabled else { return }
+        SearchFieldSpike.log("scanner armed variant=\(SearchFieldSpike.variant?.rawValue ?? "-")")
+        loop = Task { [weak self] in
+            while !Task.isCancelled {
+                self?.scan()
+                try? await Task.sleep(nanoseconds: 250_000_000)
+            }
+        }
+    }
+
+    private func scan() {
+        guard let scene = window?.windowScene else { return }
+        SpikePressLogger.shared.install(on: scene.windows)
+        var hits: [String] = []
+        var layout: String?
+        var tabBar = "none"
+        for win in scene.windows where !win.isHidden {
+            walk(win, window: win, hits: &hits, layout: &layout, tabBar: &tabBar)
+        }
+
+        let keyboard = hits.isEmpty ? "none" : hits.joined(separator: " | ")
+        if keyboard != lastKeyboard {
+            lastKeyboard = keyboard
+            SearchFieldSpike.log("kb \(keyboard) screen=\(SearchFieldSpike.screen) tab=\(SearchFieldSpike.tab)")
+        }
+        if let layout, SearchFieldSpike.KeyboardState.shared.layout != layout {
+            SearchFieldSpike.KeyboardState.shared.layout = layout
+            SearchFieldSpike.log("layout \(layout)")
+        }
+
+        let focus = scene.focusSystem?.focusedItem.map { String(describing: type(of: $0)) } ?? "nil"
+        if focus != lastFocus {
+            lastFocus = focus
+            SearchFieldSpike.log("focus \(focus) screen=\(SearchFieldSpike.screen) tab=\(SearchFieldSpike.tab) blocker=\(HiddenTabBarFocusBlocker.isBlocking ? 1 : 0)")
+        }
+        if tabBar != lastTabBar {
+            lastTabBar = tabBar
+            SearchFieldSpike.log("tabbar \(tabBar)")
+        }
+    }
+
+    private func walk(
+        _ view: UIView,
+        window: UIWindow,
+        hits: inout [String],
+        layout: inout String?,
+        tabBar: inout String
+    ) {
+        if view.isHidden || view.alpha < 0.01 { return }
+        let name = String(describing: type(of: view))
+        if let bar = view as? UITabBar {
+            let f = bar.convert(bar.bounds, to: window)
+            tabBar = "y=\(Int(f.minY)) h=\(Int(f.height)) onscreen=\(f.intersects(window.bounds) ? 1 : 0)"
+        }
+        if name.contains("Keyboard") {
+            let f = view.convert(view.bounds, to: window)
+            if f.width > 200, f.height > 40, f.intersects(window.bounds) {
+                let kind = (f.height > 320 && f.width < 900) ? "grid" : (f.width >= 900 ? "linear" : "other")
+                if kind != "other" { layout = kind }
+                hits.append("\(name) \(kind) \(Int(f.minX)),\(Int(f.minY)) \(Int(f.width))x\(Int(f.height))")
+                return
+            }
+        }
+        for sub in view.subviews {
+            walk(sub, window: window, hits: &hits, layout: &layout, tabBar: &tabBar)
+        }
+    }
+}
+
+// MARK: - Wave 0 (U3): press logger and the Menu router
+
+/// Passive: logs every remote press with the focused item at press time, on every window of the
+/// scene (the inline keyboard may live in its own window). Recognizes alongside everything and
+/// cancels nothing.
+final class SpikePressLogger: NSObject, UIGestureRecognizerDelegate {
+    static let shared = SpikePressLogger()
+    private var installed: Set<ObjectIdentifier> = []
+    private static let types: [(UIPress.PressType, String)] = [
+        (.menu, "menu"), (.upArrow, "up"), (.downArrow, "down"), (.leftArrow, "left"),
+        (.rightArrow, "right"), (.select, "select"), (.playPause, "playpause"),
+    ]
+
+    func install(on windows: [UIWindow]) {
+        for window in windows where !installed.contains(ObjectIdentifier(window)) {
+            installed.insert(ObjectIdentifier(window))
+            for (type, _) in Self.types {
+                let r = UITapGestureRecognizer(target: self, action: #selector(pressed(_:)))
+                r.allowedPressTypes = [NSNumber(value: type.rawValue)]
+                r.allowedTouchTypes = []
+                r.cancelsTouchesInView = false
+                r.delaysTouchesBegan = false
+                r.delaysTouchesEnded = false
+                r.delegate = self
+                window.addGestureRecognizer(r)
+            }
+            SearchFieldSpike.log("presslogger installed window=\(type(of: window)) level=\(Int(window.windowLevel.rawValue))")
+        }
+    }
+
+    @objc private func pressed(_ r: UITapGestureRecognizer) {
+        let raw = (r.allowedPressTypes.first as? NSNumber)?.intValue ?? -1
+        let name = Self.types.first { $0.0.rawValue == raw }?.1 ?? "\(raw)"
+        // The recognizer sits ON the window, and a UIWindow's own `window` is nil: read the scene
+        // from the window itself (Wave 0 run 2 logged `focus=nil` for every press before this).
+        let scene = (r.view as? UIWindow)?.windowScene ?? r.view?.window?.windowScene
+        let focus = scene?.focusSystem?.focusedItem.map { String(describing: type(of: $0)) } ?? "nil"
+        SearchFieldSpike.log("press \(name) window=\(type(of: r.view ?? UIView())) focus=\(focus) inKeyboard=\(SearchMenuRouter.focusIsInSystemKeyboard(scene) ? 1 : 0)")
+    }
+
+    func gestureRecognizer(_ g: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith o: UIGestureRecognizer) -> Bool { true }
+}
+
+/// U3 prototype. A zero-size view that, while Search is on screen, puts a CONSUMING Menu recognizer
+/// on every window of the scene. It only receives a press when Sidebar mode is on, the sidebar
+/// doesn't hold focus, and the focused item is inside the system keyboard (`shouldReceive`), so
+/// every other Menu press never touches it. On recognize it opens the sidebar.
+struct SearchMenuRouter: UIViewRepresentable {
+    let chrome: SidebarChromeModel
+
+    func makeUIView(context: Context) -> RouterView {
+        let v = RouterView()
+        v.chrome = chrome
+        return v
+    }
+    func updateUIView(_ uiView: RouterView, context: Context) { uiView.chrome = chrome }
+    static func dismantleUIView(_ uiView: RouterView, coordinator: ()) { uiView.uninstall() }
+
+    /// The spike probe's class-name heuristic: the focused view, or an ancestor, is a keyboard view.
+    static func focusIsInSystemKeyboard(_ scene: UIWindowScene?) -> Bool {
+        guard let item = scene?.focusSystem?.focusedItem else { return false }
+        var node: UIView? = item as? UIView
+        while let v = node {
+            let name = String(describing: type(of: v))
+            if name.contains("Keyboard") { return true }
+            node = v.superview
+        }
+        return false
+    }
+
+    final class RouterView: UIView, UIGestureRecognizerDelegate {
+        var chrome: SidebarChromeModel?
+        private var installed: [(UIWindow, UITapGestureRecognizer)] = []
+
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            uninstall()
+            guard SearchFieldSpike.menuRouter, let scene = window?.windowScene else { return }
+            for w in scene.windows {
+                let r = UITapGestureRecognizer(target: self, action: #selector(menu))
+                r.allowedPressTypes = [NSNumber(value: UIPress.PressType.menu.rawValue)]
+                r.allowedTouchTypes = []
+                // Consuming: hold the press until recognized and cancel it in the view, so neither
+                // the search container (focus to the hidden tab bar) nor the app exit sees it.
+                r.cancelsTouchesInView = true
+                r.delaysTouchesBegan = true
+                r.delegate = self
+                w.addGestureRecognizer(r)
+                installed.append((w, r))
+            }
+            SearchFieldSpike.log("router installed windows=\(installed.count)")
+            startRedirect()
+        }
+
+        func uninstall() {
+            stopRedirect()
+            for (w, r) in installed { w.removeGestureRecognizer(r) }
+            if !installed.isEmpty { SearchFieldSpike.log("router uninstalled") }
+            installed.removeAll()
+        }
+
+        func gestureRecognizer(_ g: UIGestureRecognizer, shouldReceive press: UIPress) -> Bool {
+            let sidebar = SidebarChrome.isEnabled()
+            let chromeFocused = chrome?.isFocusedChrome ?? false
+            let inKeyboard = SearchMenuRouter.focusIsInSystemKeyboard(window?.windowScene)
+            let take = sidebar && !chromeFocused && inKeyboard
+            SearchFieldSpike.log("router gate take=\(take ? 1 : 0) sidebar=\(sidebar ? 1 : 0) chromeFocused=\(chromeFocused ? 1 : 0) inKeyboard=\(inKeyboard ? 1 : 0)")
+            return take
+        }
+
+        /// Exclusive, except with the passive press logger: when the router takes the press, the
