+        /// recognizer can fire at all next to the search container's own Menu handling (run 4: it
+        /// took the press but never recognized; focus went to the hidden tab bar 62 ms later).
+        func gestureRecognizer(_ g: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith o: UIGestureRecognizer) -> Bool {
+            true
+        }
+
+        @objc private func menu() {
+            SearchFieldSpike.log("router recognized menu (log only)")
+        }
+
+        // MARK: Run 4b: redirect focus that lands on the hidden system tab bar into the sidebar.
+
+        private var focusObserver: NSObjectProtocol?
+
+        func startRedirect() {
+            guard focusObserver == nil else { return }
+            focusObserver = NotificationCenter.default.addObserver(forName: UIFocusSystem.didUpdateNotification, object: nil, queue: .main) { [weak self] note in
+                MainActor.assumeIsolated { self?.focusUpdated(note) }
+            }
+        }
+
+        func stopRedirect() {
+            if let focusObserver { NotificationCenter.default.removeObserver(focusObserver) }
+            focusObserver = nil
+        }
+
+        private func focusUpdated(_ note: Notification) {
+            guard SidebarChrome.isEnabled(), !(chrome?.isFocusedChrome ?? false) else { return }
+            let ctx = note.userInfo?[UIFocusSystem.focusUpdateContextUserInfoKey] as? UIFocusUpdateContext
+            guard let next = ctx?.nextFocusedItem else { return }
+            let name = String(describing: type(of: next))
+            guard name.contains("UITabBarButton") else { return }
+            let prev = ctx?.previouslyFocusedItem.map { String(describing: type(of: $0)) } ?? "nil"
+            SearchFieldSpike.log("router redirect hiddenTabBar prev=\(prev) heading=\(ctx?.focusHeading.rawValue ?? 0) -> requestReveal")
