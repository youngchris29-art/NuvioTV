filters:
  and:
    - 'type == "comms"'
    - 'state == "not-sent"'
views:
  - type: table
    name: Comms not sent
    groupBy:
      property: note.channel
      direction: ASC
    order:
      - file.name
      - note.date
      - note.target
      - note.deslop
      - note.cleansed
      - note.release
      - note.batch
    sort:
      - property: note.date
        direction: DESC
