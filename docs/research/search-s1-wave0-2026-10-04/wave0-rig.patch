+
+    private func w0Dump(_ app: XCUIApplication, _ tag: String) {
+        let sf = app.searchFields
+        let kb = app.keyboards
+        var line = "W0 [\(tag)] searchFields=\(sf.count) textFields=\(app.textFields.count) keyboards=\(kb.count) keys=\(app.keys.count)"
+        if kb.count > 0 { line += " kbFrame=\(kb.firstMatch.frame)" }
+        if sf.count > 0 {
+            let f = sf.firstMatch
+            line += " sfFrame=\(f.frame) sfValue=\(String(describing: f.value)) sfLabel=\(f.label) sfFocus=\(f.hasFocus)"
+        }
+        if let focused = focusedButton(app) { line += " focusedButton=\(focused.label)" }
+        print(line)
+    }
+
+    private func runW0Searchable(variant: String, extra: [String] = []) {
+        let app = launchToHome(extraArguments: ["-debug.searchFieldSpike", variant] + extra, forceFreshLaunch: true)
+        shot(app, "w0-\(variant)-home")
+        openTab(app, named: "Search")
+        pause(2)
+        shot(app, "w0-\(variant)-search-open")
+        w0Dump(app, "\(variant) open")
+
+        app.typeText("dune")
+        pause(3)
+        shot(app, "w0-\(variant)-typed")
+        w0Dump(app, "\(variant) typed")
+
+        // Into the results: Right off a Grid keyboard (narrow), Down off a Linear one.
+        let kbFrame = app.keyboards.firstMatch.exists ? app.keyboards.firstMatch.frame : .zero
+        let grid = kbFrame.width > 0 && kbFrame.width < 900
+        print("W0 [\(variant)] layout=\(grid ? "grid" : "linear-or-unknown") kbFrame=\(kbFrame)")
+        if grid { press(.right, times: 7, gap: 0.5) } else { press(.down, times: 1) }
+        pause(1)
+        w0Dump(app, "\(variant) inResults")
+        shot(app, "w0-\(variant)-in-results")
+
+        remote.press(.select)
+        pause(5)
+        shot(app, "w0-\(variant)-detail")
+        w0Dump(app, "\(variant) detail")
+
+        remote.press(.menu)
