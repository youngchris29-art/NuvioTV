filters:
  and:
    - 'type == "batch"'
    - 'state == "landed"'
views:
  - type: table
    name: Landed, not cut
    order:
      - file.name
      - note.date
      - note.base
      - note.tip
      - note.new_settings
      - note.device_pass
      - note.comms
    sort:
      - property: note.date
        direction: ASC
