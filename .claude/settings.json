{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(python3 scripts/deslop/deslop.py *)",
      "Bash(python3 scripts/deslop/test_deslop.py)",
      "Bash(.claude/skills/codex-review/tools/review.sh *)",
      "Bash(bash .claude/skills/codex-review/tools/review.sh *)",
      "Bash(cd NuvioMobile && graphify query *)",
      "Bash(cd NuvioMobile && graphify explain *)",
      "Bash(cd NuvioMobile && graphify path *)",
      "Bash(cd NuvioMobile && graphify affected *)",
      "Bash(cd NuvioMobile && graphify update *)",
      "Bash(scripts/graph-impact.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "GRAPHIFY_OUT=NuvioMobile/graphify-out graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "GRAPHIFY_OUT=NuvioMobile/graphify-out graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
