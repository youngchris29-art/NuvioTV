filters:
  and:
    - 'type == "device-pass"'
    - 'result != "pass"'
views:
  - type: table
    name: Device steps open
    order:
      - file.name
      - note.date
      - note.profile
      - note.build
      - note.result
      - note.not_run
      - note.failed
      - note.for_christian
      - note.batch
    sort:
      - property: note.date
        direction: DESC
