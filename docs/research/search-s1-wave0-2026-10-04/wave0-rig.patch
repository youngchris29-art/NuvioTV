+
+// MARK: - Wave 0 (U4 mode 2): link the tab bar from the tab controller down
+
+/// Mounted in the background of Search's results stack. Finds the scroll view it sits in, finds the
+/// `UITabBarController` from the window root (children first, presented last — the same walk
+/// `HiddenTabBarFocusBlocker` uses), and sets that scroll view as the content scroll view of the
+/// selected tab's controllers (navigation controllers skipped, like `TabBarContentScrollLink`).
+/// Re-applied on every focus update; withdrawn when the view leaves the window.
+struct SpikeTopDownTabLink: UIViewRepresentable {
+    func makeUIView(context: Context) -> LinkView { LinkView() }
+    func updateUIView(_ uiView: LinkView, context: Context) {}
+
+    final class LinkView: UIView {
+        private var observer: NSObjectProtocol?
+        private weak var linkedScroll: UIScrollView?
+        private var linked: [WeakVC] = []
+        private var logged = false
+        struct WeakVC { weak var vc: UIViewController? }
+
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            if window == nil { withdraw(); return }
+            for delay in [0.0, 0.3, 1.0, 2.5] {
+                DispatchQueue.main.asyncAfter(deadline: .now() + delay) { [weak self] in self?.apply() }
+            }
+            if observer == nil {
+                observer = NotificationCenter.default.addObserver(forName: UIFocusSystem.didUpdateNotification, object: nil, queue: .main) { [weak self] _ in
+                    MainActor.assumeIsolated { self?.apply() }
+                }
+            }
+        }
+
+        override func willMove(toWindow newWindow: UIWindow?) {
+            super.willMove(toWindow: newWindow)
+            if newWindow == nil { withdraw() }
+        }
+
+        private func withdraw() {
+            for w in linked { if let vc = w.vc, vc.contentScrollView(for: .top) === linkedScroll { vc.setContentScrollView(nil, for: .top) } }
+            if !linked.isEmpty { SearchFieldSpike.log("tablink2 withdrawn controllers=\(linked.count)") }
+            linked = []
+            if let observer { NotificationCenter.default.removeObserver(observer); self.observer = nil }
+        }
+
+        private func apply() {
+            guard window != nil, let sv = enclosingScrollView(), let root = window?.rootViewController else { return }
+            guard let tab = Self.findTab(root) else {
+                if !logged { logged = true; SearchFieldSpike.log("tablink2 FAILED no UITabBarController under the window root") }
+                return
+            }
+            var targets: [UIViewController] = []
+            var node: UIViewController? = tab.selectedViewController
+            var depth = 0
+            while let c = node, depth < 6 {
+                // Only controllers whose view actually contains the results: a push or a tab switch
+                // fires a focus update before this view leaves the window, and the selected chain
+                // then belongs to another screen (sim 26.5: Detail's and Library's controllers).
+                if !(c is UINavigationController), c.isViewLoaded, self.isDescendant(of: c.view) { targets.append(c) }
+                node = (c as? UINavigationController)?.topViewController ?? c.children.first
+                depth += 1
+            }
+            guard !targets.isEmpty else { return }
+            var changed = false
+            for vc in targets where vc.contentScrollView(for: .top) !== sv {
+                vc.setContentScrollView(sv, for: .top)
+                changed = true
+            }
+            linkedScroll = sv
+            linked = targets.map { WeakVC(vc: $0) }
+            if changed || !logged {
+                logged = true
+                SearchFieldSpike.log("tablink2 linked targets=\(targets.map { String(describing: type(of: $0)).prefix(40) }.joined(separator: " > ")) sv=\(type(of: sv)) svh=\(Int(sv.bounds.height))")
+            }
+        }
+
+        private func enclosingScrollView() -> UIScrollView? {
+            var node = superview
+            while let v = node { if let s = v as? UIScrollView { return s }; node = v.superview }
+            return nil
+        }
+
+        static func findTab(_ vc: UIViewController) -> UITabBarController? {
+            if let t = vc as? UITabBarController { return t }
+            for child in vc.children { if let t = findTab(child) { return t } }
+            if let p = vc.presentedViewController { return findTab(p) }
+            return nil
+        }
+    }
+}
